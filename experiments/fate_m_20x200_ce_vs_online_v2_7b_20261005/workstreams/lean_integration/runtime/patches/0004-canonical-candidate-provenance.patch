+/-- Freeze the executor action and its exact token span. Ordinary responses are
+executed byte-for-byte, including leading whitespace. A single `<think>` prefix
+is removed only when the remaining suffix ends exactly at the response-content
+token boundary. No unanchored first-match search is permitted. -/
+private def actionAndExactTokenSpan (choice : ProvenanceChatChoice) : Option (String × Nat × Nat) := do
+  let logprobs ← choice.logprobs
+  let tokens := (← logprobs.content).toArray
+  let rawAction := choice.message.content
+  let mut rendered := ""
+  let mut rawStop : Option Nat := none
+  for (token, index) in tokens.zipIdx do
+    rendered := rendered ++ token.token
+    if rendered == rawAction && rawStop.isNone then rawStop := some (index + 1)
+  let stop ← rawStop
+  let trimmed := rawAction.trimAsciiStart.toString
+  if !trimmed.startsWith "<think>" then
+    return (rawAction, 0, stop)
+  let parts := trimmed.splitOn "</think>"
+  if parts.length != 2 then failure
+  let action := parts[1]!
+  if action.trimAscii.toString.isEmpty then failure
+  let mut starts : Array Nat := #[]
+  for start in List.range stop do
+    let suffix := (tokens.extract start stop).foldl (fun text token => text ++ token.token) ""
+    if suffix == action then starts := starts.push start
+  if starts.isEmpty then failure
+  -- Byte-level BPE may require several raw tokens to complete one UTF-8
+  -- character.  The policy service renders earlier partial-byte tokens as
+  -- empty strings; choose the earliest matching boundary so the action span
+  -- retains every contributing token and its log-probability.
+  return (action, starts[0]!, stop)
+
