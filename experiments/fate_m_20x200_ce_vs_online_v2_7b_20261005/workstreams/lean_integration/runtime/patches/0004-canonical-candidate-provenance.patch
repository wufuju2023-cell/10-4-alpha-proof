+/-- Event identities for the exact solved edges selected by proof extraction.
+Focus edges are structural and therefore contribute no model-action event. -/
+partial def selectedEventIdsForSolvedNode
+    (nodes : Array (Node NodeData (EdgeData × Nat))) (nodeIdx : Nat) :
+    Except String (Array String) := do
+  let some node := nodes[nodeIdx]?
+    | throw s!"MCTS selected-path node index out of bounds: {nodeIdx}"
+  match node.data.toPlay with
+  | .orNode =>
+      match solvedOrChild? nodes node with
+      | some (edge, childIdx) =>
+          let some eventId := edge.canonicalEventId
+            | throw s!"Solved model edge at node {nodeIdx} lacks canonical event identity"
+          return #[eventId] ++ (← selectedEventIdsForSolvedNode nodes childIdx)
+      | none =>
+          if node.data.isSolved then return #[]
+          else throw s!"MCTS selected path could not find a solved OR child at node {nodeIdx}"
+  | .andNode =>
+      let children := solvedFocusChildren nodes node
+      if children.isEmpty then
+        if node.data.isSolved then return #[]
+        else throw s!"MCTS selected path could not find solved focus children at node {nodeIdx}"
+      if children.size != 1 then
+        throw s!"Canonical linear selected path cannot represent branching AND node {nodeIdx}"
+      let mut result := #[]
+      for (_, childIdx) in children do
+        result := result ++ (← selectedEventIdsForSolvedNode nodes childIdx)
+      return result
+
